// Sonadial Player — Slint software-rendered UI (slint-ui branch).
// Faithful port of the egui-era TUI: frameless window with a custom top bar,
// LIBRARY sidebar, dock console, stage labels and the SYSTEM/EQ/BILIBILI
// overlay panels. The full-window stage (theme gradient, background LED wall,
// radial spectrum, core dial, beat ring) is painted by the CPU in src/stage.rs
// and delivered as an opaque image.

import { Style, Theme } from "style.slint";
export { Style, Theme }
import { InkBtn, TuiBtn, TabBtn, CloseX, ChipBtn, MenuRow, AsciiMeter } from "widgets.slint";

export struct TrackRow {
    index: int,
    title: string,
    meta: string,
    has-lrc: bool,
    selected: bool,
    playing: bool,
    focused: bool,
}

export struct ChipData {
    name: string,
    grad-a: color,
    grad-b: color,
    fg: color,
    dim: color,
    active: bool,
    dark: bool,
    index: int,
    col: int,
    row: int,
}

export struct ChipGroup {
    label: string,
    rows: int,
    chips: [ChipData],
}

export struct ShortcutRow {
    index: int,
    keys: string,
    desc: string,
}

export struct EqBandData {
    gain: float,
    label: string,
    freq: string,
}

export component Main inherits Window {
    // width/height here would freeze the Slint scene even after the native
    // window maximizes. Preferred sizes only set the initial window size.
    preferred-width: Style.window-w;
    preferred-height: Style.window-h;
    min-width: Style.window-min-w;
    min-height: Style.window-min-h;
    title: "Sonadial Player";
    default-font-family: Style.family-ui;
    default-font-size: Style.font-caption;
    no-frame: true;
    resize-border-width: root.window-maximized ? 0px : Style.resize-border;
    background: Theme.c-bg;

    // ---------- geometry ----------
    in-out property <bool> window-maximized: false;
    in-out property <bool> sidebar-open: true;
    property <length> sidebar-w: root.sidebar-open ? Style.sidebar-w : 0px;
    out property <length> stage-x: root.sidebar-w;
    out property <length> stage-y: Style.topbar-h;
    out property <length> stage-w: Math.max(1px, root.width - root.sidebar-w);
    out property <length> stage-h: Math.max(1px, root.height - Style.topbar-h - Style.dock-h);

    out property <length> library-viewport-h: Math.max(1px,
        root.stage-h - Style.library-list-top - Style.space-sm);
    out property <length> dock-content-w: Math.max(Style.dock-content-min-w,
        root.width * Style.dock-content-fraction);

    // ---------- stage ----------
    in-out property <image> stage;
    in-out property <length> disc-r: 80px;
    in-out property <string> lyric-current: "";
    in-out property <string> lyric-next: "";
    in-out property <bool> lyric-active: false;
    in-out property <bool> show-lyrics: true;

    // ---------- playlist ----------
    in-out property <[TrackRow]> tracks;
    in-out property <string> search-text;
    in-out property <int> track-count: 0;
    in-out property <string> mode-short: "SQ";
    in-out property <float> scroll-y: 0;
    in-out property <float> scroll-max: 0;
    in-out property <int> current-cell: -1;
    in-out property <int> selected-index: -1;
    in-out property <bool> scroll-active: false;
    in-out property <int> context-index: -1;
    in-out property <length> context-x: 0px;
    in-out property <length> context-y: 0px;
    in-out property <string> context-title: "";
    in-out property <bool> context-has-lrc: false;

    // ---------- dock ----------
    in-out property <string> dock-title: "DROP AUDIO HERE / CTRL+O";
    in-out property <bool> dock-title-live: false;
    in-out property <string> meta-prefix: "---   0.0K   ";
    in-out property <string> meta-output: "NO OUTPUT";
    in-out property <string> mode-text: "MODE: SEQUENCE";
    in-out property <float> progress: 0;
    in-out property <int> seek-cells: 36;
    in-out property <int> seek-filled: 0;
    in-out property <string> seek-filled-str: "";
    in-out property <string> seek-rest-str: "";
    in-out property <string> time-text: "0:00 / 0:00";
    in-out property <string> play-label: "PLAY";
    in-out property <string> core-status: "[STANDBY]";
    in-out property <string> vol-fill-str: "";
    in-out property <int> vol-filled: 0;
    in-out property <string> vol-rest-str: "";
    in-out property <string> vol-pct: " 62%";

    // ---------- overlays ----------
    in-out property <bool> show-settings: false;
    in-out property <bool> show-eq: false;
    in-out property <bool> show-download: false;
    in-out property <int> settings-page: 0;
    in-out property <string> out-label: "";
    in-out property <string> state-path: "";
    in-out property <string> mode-long: "SEQUENCE";
    in-out property <float> radial-scale: 1.0;
    in-out property <int> visual-style: 0;
    in-out property <bool> show-bg-spectrum: true;
    in-out property <bool> show-radial: true;
    in-out property <bool> show-core-pulse: true;
    in-out property <bool> peak-hold: true;
    in-out property <string> theme-current-line: "CURRENT: --- / ---";
    in-out property <string> theme-auto-status: "";
    in-out property <string> theme-file-path: "";
    in-out property <string> theme-load-error: "";
    in-out property <string> theme-warnings: "";
    in-out property <bool> theme-can-customize: true;
    in-out property <string> theme-customize-label: "[ CUSTOMIZE ]";
    in-out property <[ChipData]> auto-chips;
    in-out property <[ChipGroup]> theme-groups;
    in-out property <[ShortcutRow]> shortcuts;
    in-out property <float> theme-content-h: 0;

    // ---------- eq ----------
    in-out property <[EqBandData]> eq-bands;
    in-out property <bool> eq-enabled: false;
    in-out property <string> eq-preset-name: "CUSTOM  ";
    in-out property <string> eq-hint: "EQ BYPASS / DRAG TO EDIT";

    // ---------- download ----------
    in-out property <string> download-url: "";
    in-out property <string> proxy-text: "";
    in-out property <bool> env-proxy-visible: false;
    in-out property <bool> download-running: false;
    in-out property <string> download-progress-text: "";
    in-out property <string> download-status: "";
    in-out property <string> download-out-dir: "";

    // ---------- modal / toast ----------
    in-out property <bool> confirm-visible: false;
    in-out property <string> confirm-name: "";
    in-out property <string> confirm-path: "";
    in-out property <bool> error-visible: false;
    in-out property <string> error-text: "";

    // ---------- callbacks ----------
    callback toggle-sidebar();
    callback minimize();
    callback toggle-maximize();
    callback close-app();
    callback toggle-settings();
    callback toggle-eq();
    callback toggle-visual-mode();
    callback open-download();
    callback add-files();
    callback cycle-mode();
    callback play-index(int);
    callback select-track(int);
    callback queue-next(int);
    callback import-lrc(int);
    callback clear-lrc(int);
    callback open-track-location(int);
    callback remove-track(int);
    callback delete-track(int);
    callback confirm-delete();
    callback cancel-delete();
    callback toggle-play();
    callback next-track();
    callback prev-track();
    callback stop();
    callback seek(float);
    callback seek-preview(float);
    callback set-volume(float);
    callback set-style(int);
    callback toggle-bg-spectrum();
    callback toggle-radial();
    callback toggle-core-pulse();
    callback toggle-lyrics();
    callback toggle-peak-hold();
    callback adjust-radial-scale(float);
    callback select-theme(int);
    callback select-auto-theme(bool);
    callback reload-themes();
    callback customize-theme();
    callback open-data-dir();
    callback search-changed(string);
    callback open-context(int, float, float);
    callback scroll-to(float);
    callback set-band(int, float);
    callback cycle-eq-preset(int);
    callback toggle-eq-enabled();
    callback reset-eq();
    callback start-download();
    callback cancel-download();
    callback open-download-dir();
    callback use-env-proxy();
    callback set-download-url(string);
    callback set-proxy(string);
    callback clear-error();

    // Global hotkeys: an always-focusable scope mirrors the egui input map.
    FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.modifiers.control && e.text == "o") {
                root.add-files();
                accept
            } else if (e.text == " ") {
                root.toggle-play();
                accept
            } else if (e.text == "Up") {
                root.set-volume(-1.0);
                accept
            } else if (e.text == "Down") {
                root.set-volume(-2.0);
                accept
            } else if (e.text == "Left") {
                root.seek(-1.0);
                accept
            } else if (e.text == "Right") {
                root.seek(-2.0);
                accept
            } else if (e.text == "PageUp") {
                root.prev-track();
                accept
            } else if (e.text == "PageDown") {
                root.next-track();
                accept
            } else if (e.text == "Escape") {
                // Overlays close through the Rust toggles: writing the
                // properties here would be overwritten by the next frame push.
                if (root.confirm-visible) {
                    root.cancel-delete();
                } else if (root.error-visible) {
                    root.clear-error();
                } else if (root.show-settings) {
                    root.toggle-settings();
                } else if (root.show-eq) {
                    root.toggle-eq();
                } else if (root.show-download) {
                    root.open-download();
                } else if (root.context-index >= 0) {
                    root.context-index = -1;
                } else {
                    reject
                }
                accept
            } else {
                reject
            }
        }
    }

    // ============ stage (CPU-painted, opaque, full window) ============
    Image {
        source: root.stage;
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        image-fit: fill;
        image-rendering: pixelated;
    }

    // Core dial status: elapsed/total over [PLAYING]/[PAUSED]/[STANDBY],
    // mirrored from the egui paint_core readout. Clicking the strip toggles
    // playback.
    property <length> core-cx: Math.round((root.stage-x + root.stage-w / 2) / 1px) * 1px;
    property <length> core-cy: root.stage-y + root.stage-h / 2;
    Rectangle {
        x: root.core-cx - 90px;
        y: root.core-cy - root.disc-r * 0.04 - 18px;
        width: 180px;
        height: root.disc-r * 0.34 + 40px;
        background: transparent;
        TouchArea {
            mouse-cursor: pointer;
            clicked => root.toggle-play();
        }
    }
    Text {
        x: root.core-cx - 100px;
        width: 200px;
        y: root.core-cy - root.disc-r * 0.04 - self.height / 2;
        text: root.time-text;
        font-size: root.disc-r >= 56px ? Style.font-core : Style.font-caption;
        color: Theme.c-text-hi;
        horizontal-alignment: center;
    }
    Text {
        x: root.core-cx - 100px;
        width: 200px;
        y: root.core-cy + root.disc-r * 0.30 - self.height / 2;
        text: root.core-status;
        font-size: Style.font-caption;
        color: root.core-status == "[PLAYING]" ? Theme.c-text : Theme.c-text-dim;
        horizontal-alignment: center;
    }

    // ============ lyrics (typewriter, top-left of stage) ============
    Text {
        visible: root.show-lyrics;
        x: root.stage-x + Style.lyric-inset;
        y: root.stage-y + Style.lyric-current-y;
        width: root.stage-x + root.stage-w - Style.lyric-inset - self.x;
        text: root.lyric-current;
        font-family: Style.family-pixel;
        font-size: Style.font-lyric;
        color: root.lyric-active ? Theme.c-text-hi : Theme.c-text-dim;
        overflow: elide;
    }
    Text {
        visible: root.show-lyrics;
        x: root.stage-x + Style.lyric-inset;
        y: root.stage-y + Style.lyric-next-y;
        width: root.stage-x + root.stage-w - Style.lyric-inset - self.x;
        text: root.lyric-next;
        font-family: Style.family-pixel;
        font-size: Style.font-lyric-next;
        color: Theme.c-text-dim;
        overflow: elide;
    }

    // ============ top bar ============
    Rectangle {
        y: 0;
        width: parent.width;
        height: Style.topbar-h;
        Rectangle {
            y: parent.height - Style.stroke;
            width: parent.width;
            height: Style.stroke;
            background: Theme.c-line;
        }
        InkBtn {
            x: Style.topbar-inset;
            y: (parent.height - Style.control-h) / 2;
            width: Style.topbar-toggle-w;
            label: "[=]";
            clicked => root.toggle-sidebar();
        }
        Text {
            x: Style.topbar-inset * 2 + Style.topbar-toggle-w;
            height: parent.height;
            vertical-alignment: center;
            text: "sonadial-player";
            font-size: Style.font-app-title;
            color: Theme.c-text-hi;
        }
        WindowMoveArea {
            x: 184px;
            y: Style.space-xs;
            width: parent.width - 184px - 420px;
            height: parent.height - 8px;
        }
        HorizontalLayout {
            x: parent.width - Style.topbar-inset - Style.topbar-actions-w;
            y: (parent.height - Style.control-h) / 2;
            width: Style.topbar-actions-w;
            height: Style.control-h;
            spacing: Style.space-tight;
            InkBtn {
                width: Style.topbar-mode-w;
                label: "[MODE]";
                clicked => root.toggle-visual-mode();
            }
            InkBtn {
                width: Style.topbar-eq-w;
                label: "EQ";
                clicked => root.toggle-eq();
            }
            InkBtn {
                width: Style.topbar-system-w;
                label: "SYS";
                clicked => root.toggle-settings();
            }
            InkBtn {
                width: Style.topbar-window-button-w;
                label: "-";
                clicked => root.minimize();
            }
            InkBtn {
                width: Style.topbar-window-button-w;
                label: root.window-maximized ? "[=]" : "[]";
                clicked => root.toggle-maximize();
            }
            InkBtn {
                width: Style.topbar-window-button-w;
                label: "[x]";
                clicked => root.close-app();
            }
        }
    }

    // ============ sidebar ============
    Rectangle {
        x: 0;
        y: Style.topbar-h;
        width: root.sidebar-w;
        height: root.stage-h;
        visible: root.sidebar-open;
        Rectangle {
            x: parent.width - Style.stroke;
            width: Style.stroke;
            height: parent.height;
            background: Theme.c-line;
        }
        Text {
            x: Style.library-inset;
            y: Style.space-tight;
            text: "LIBRARY";
            font-size: Style.font-library;
            color: Theme.c-text-hi;
        }
        Text {
            x: parent.width - self.width - Style.library-inset;
            y: Style.space-sm;
            text: (root.track-count < 10 ? "0" : "") + root.track-count + " TRACKS";
            font-size: Style.font-caption;
            color: Theme.c-text-dim;
        }
        Text {
            x: Style.library-inset;
            y: Style.library-search-y;
            height: Style.field-h;
            vertical-alignment: center;
            text: "find:";
            font-size: Style.font-caption;
            color: Theme.c-text-dim;
        }
        TextInput {
            x: Style.library-search-x;
            y: Style.library-search-y;
            width: parent.width - Style.library-search-x - Style.library-inset;
            height: Style.field-h;
            single-line: true;
            font-family: Style.family-pixel;
            font-size: Style.font-pixel-caption;
            color: Theme.c-text-hi;
            vertical-alignment: center;
            text <=> root.search-text;
            edited => root.search-changed(root.search-text);
        }
        Text {
            visible: root.search-text == "";
            x: Style.library-search-x;
            y: Style.library-search-y;
            height: Style.field-h;
            vertical-alignment: center;
            text: "title...";
            font-family: Style.family-pixel;
            font-size: Style.font-pixel-caption;
            color: Theme.c-text-dim.with-alpha(0.55);
        }
        Rectangle {
            x: Style.library-inset;
            y: Style.library-actions-y;
            width: Style.library-add-w;
            height: Style.control-h;
            TuiBtn {
                width: parent.width;
                label: "[ add ]";
                clicked => root.add-files();
            }
        }
        Rectangle {
            x: Style.library-inset + Style.library-add-w;
            y: Style.library-actions-y;
            width: Style.library-mode-w;
            height: Style.control-h;
            TuiBtn {
                width: parent.width;
                label: "[ mode: " + root.mode-short + " ]";
                clicked => root.cycle-mode();
            }
        }
        Rectangle {
            x: Style.library-inset + Style.library-add-w + Style.library-mode-w;
            y: Style.library-actions-y;
            width: Style.library-download-w;
            height: Style.control-h;
            TuiBtn {
                width: parent.width;
                label: "[ download ]";
                clicked => root.open-download();
            }
        }
        Rectangle {
            x: Style.library-inset;
            y: Style.library-separator-y;
            width: parent.width - Style.library-inset * 2;
            height: Style.stroke;
            background: Theme.c-line;
        }
        // Track list: manual clip + offset so the custom TUI scrollbar stays exact.
        property <length> list-top: Style.library-list-top;
        property <length> list-h: root.library-viewport-h;
        Rectangle {
            x: Style.library-list-inset;
            y: list-top;
            width: parent.width - Style.library-list-right;
            height: list-h;
            clip: true;
            // Wheel scrolling over the empty space behind the rows.
            TouchArea {
                scroll-event(e) => {
                    root.scroll-to(Math.max(0.0, Math.min(root.scroll-max,
                        root.scroll-y - e.delta-y / 1px)));
                    accept
                }
            }
            for row[i] in root.tracks: Rectangle {
                y: i * Style.row-h - root.scroll-y * 1px;
                width: parent.width;
                height: Style.row-h;
                // Inverse video only for the playing row; a single click just
                // draws a wireframe, matching the terminal look.
                background: row.selected ? Theme.c-text-hi : transparent;
                border-width: root.selected-index == row.index || (!row.selected && ta.has-hover) ? Style.stroke : 0px;
                border-color: row.selected ? Theme.c-bg
                    : (root.selected-index == row.index ? Theme.c-text-hi : Theme.c-text-hi.with-alpha(0.47));
                ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => root.select-track(row.index);
                    double-clicked => root.play-index(row.index);
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.open-context(row.index, (Style.library-list-inset + self.mouse-x) / 1px, (list-top + (i + 1) * Style.row-h - root.scroll-y * 1px) / 1px);
                        }
                    }
                    scroll-event(e) => {
                        root.scroll-to(Math.max(0.0, Math.min(root.scroll-max,
                            root.scroll-y - e.delta-y / 1px)));
                        accept
                    }
                }
                Text {
                    x: Style.space-xs;
                    height: parent.height;
                    vertical-alignment: center;
                    text: (row.selected ? "> " : "   ")
                        + (row.index + 1 >= 10 ? row.index + 1 : "0" + (row.index + 1))
                        + (row.playing ? "*" : " ") + (row.has-lrc ? "L" : " ");
                    font-size: Style.font-library;
                    color: row.selected ? Theme.c-bg : Theme.c-text-dim;
                }
                Text {
                    x: Style.library-title-x;
                    width: parent.width - Style.library-title-x - Style.library-meta-reserve;
                    height: parent.height;
                    vertical-alignment: center;
                    text: row.title;
                    font-family: Style.family-title;
                    font-size: Style.font-track-title;
                    color: row.selected ? Theme.c-bg : Theme.c-text;
                    overflow: elide;
                }
                Text {
                    x: parent.width - Style.library-meta-right;
                    width: Style.library-meta-w;
                    height: parent.height;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    text: row.meta;
                    font-size: Style.font-caption;
                    color: row.selected ? Theme.c-text-dim : Theme.c-text-dim;
                }
            }
            if (root.tracks.length == 0): Rectangle {
                width: parent.width;
                height: list-h;
                Text {
                    x: Style.space-tight;
                    y: Style.space-md;
                    text: "no tracks";
                    font-size: Style.font-library;
                    color: Theme.c-text-dim;
                }
                Text {
                    x: Style.space-tight;
                    y: 36px;
                    text: "drop audio or ctrl+o";
                    font-size: Style.font-caption;
                    color: Theme.c-text-dim;
                }
            }
        }
        // TUI scrollbar: '-' track, '#' thumb, '@' on the current row.
        property <bool> near: probe.has-hover || thumbdrag.has-hover || thumbdrag.pressed;
        property <int> cells: Math.max(1, Math.floor(list-h / Style.scroll-cell-h));
        property <float> frac: root.scroll-max > 0.5
            ? Math.min(1.0, Math.max(0.0, root.scroll-y / root.scroll-max)) : 0.0;
        property <int> thumb-cells: Math.min(cells,
            Math.max(1, Math.round(list-h / Math.max(Style.row-h, root.tracks.length * Style.row-h) * cells)));
        property <int> thumb-start: Math.max(0, Math.min(self.cells - self.thumb-cells,
            Math.round((self.cells - self.thumb-cells) * frac)));
        for i in cells: Text {
            x: parent.width - 12px;
            width: 12px;
            height: Style.scroll-cell-h;
            y: list-top + i * Style.scroll-cell-h;
            vertical-alignment: center;
            horizontal-alignment: center;
            text: root.current-cell == i ? "@"
                : (i >= thumb-start && i < thumb-start + thumb-cells ? "#" : "-");
            font-size: Style.font-caption;
            color: root.current-cell == i ? Theme.c-text-hi
                : (i >= thumb-start && i < thumb-start + thumb-cells
                    ? (root.scroll-active ? Theme.c-text-hi
                        : (near ? Theme.c-text-dim : Theme.c-text-dim.with-alpha(0.35)))
                    : Theme.c-text-dim.with-alpha(near ? 0.43 : 0.14));
        }
        thumbdrag := TouchArea {
            x: parent.width - Style.scroll-w;
            y: list-top;
            width: Style.scroll-w;
            height: list-h;
            mouse-cursor: ns-resize;
            moved => {
                root.scroll-active = true;
                if (root.scroll-max > 0.5) {
                    root.scroll-to(Math.min(1.0, Math.max(0.0, self.mouse-y / list-h)) * root.scroll-max);
                }
            }
            pointer-event(e) => {
                root.scroll-active = e.kind == PointerEventKind.down;
                if (e.kind == PointerEventKind.down && root.scroll-max > 0.5) {
                    root.scroll-to(Math.min(1.0, Math.max(0.0, self.mouse-y / list-h)) * root.scroll-max);
                }
            }
            scroll-event(e) => {
                root.scroll-to(Math.max(0.0, Math.min(root.scroll-max,
                    root.scroll-y - e.delta-y / 1px)));
                accept
            }
        }
        probe := TouchArea {
            x: parent.width - Style.scroll-w * 3;
            y: list-top;
            width: Style.scroll-w * 2;
            height: list-h;
            scroll-event(e) => {
                root.scroll-to(Math.max(0.0, Math.min(root.scroll-max,
                    root.scroll-y - e.delta-y / 1px)));
                accept
            }
        }
    }

    // ============ dock ============
    Rectangle {
        y: parent.height - Style.dock-h;
        width: parent.width;
        height: Style.dock-h;
        Rectangle {
            y: 0;
            width: parent.width;
            height: Style.stroke;
            background: Theme.c-line;
        }
        Text {
            x: Style.dock-inset;
            y: Style.dock-title-y;
            width: root.dock-content-w;
            height: Style.dock-title-h;
            vertical-alignment: center;
            text: root.dock-title;
            font-family: Style.family-title;
            font-size: Style.font-dock-title;
            color: root.dock-title-live ? Theme.c-text-hi : Theme.c-text-dim;
            overflow: elide;
        }
        Text {
            x: Style.dock-inset;
            y: Style.dock-meta-y;
            text: root.meta-prefix + root.meta-output;
            font-size: Style.font-caption;
            color: Theme.c-text-dim;
        }
        Text {
            x: parent.width - self.width - Style.dock-inset;
            y: Style.dock-meta-y;
            text: root.mode-text;
            font-size: Style.font-caption;
            color: Theme.c-text-dim;
        }
        AsciiMeter {
            x: Style.dock-inset;
            y: Style.dock-seek-y;
            height: Style.dock-seek-h;
            cells: root.seek-cells;
            filled: root.seek-filled;
            fill-text: root.seek-filled-str;
            rest-text: root.seek-rest-str;
            label: root.time-text;
            preview(position) => root.seek-preview(position);
            changed(position) => root.seek(position);
        }
        AsciiMeter {
            x: Style.dock-inset;
            y: Style.dock-controls-y;
            height: Style.dock-controls-h;
            prefix: "VOL [";
            prefix-cells: 5;
            cells: Style.dock-volume-cells;
            filled: root.vol-filled;
            fill-text: root.vol-fill-str;
            rest-text: root.vol-rest-str;
            label: root.vol-pct;
            label-gap: self.cell-w;
            ink: Theme.c-text;
            commit-on-press: true;
            preview(position) => root.set-volume(position * Style.volume-max);
            changed(position) => root.set-volume(position * Style.volume-max);
        }
        HorizontalLayout {
            x: Math.round((parent.width - Style.dock-transport-w) / 2 / 1px) * 1px;
            y: Style.dock-controls-y;
            width: Style.dock-transport-w;
            height: Style.dock-controls-h;
            spacing: Style.dock-button-gap;
            InkBtn {
                width: Style.dock-button-w;
                height: Style.dock-controls-h;
                text-size: Style.font-dock-control;
                label: "< PREV";
                clicked => root.prev-track();
            }
            InkBtn {
                width: Style.dock-button-w;
                height: Style.dock-controls-h;
                text-size: Style.font-dock-control;
                label: root.play-label;
                clicked => root.toggle-play();
            }
            InkBtn {
                width: Style.dock-stop-w;
                height: Style.dock-controls-h;
                text-size: Style.font-dock-control;
                label: "STOP";
                clicked => root.stop();
            }
            InkBtn {
                width: Style.dock-button-w;
                height: Style.dock-controls-h;
                text-size: Style.font-dock-control;
                label: "NEXT >";
                clicked => root.next-track();
            }
        }
    }

    // ============ right-click context menu ============
    // Lives at window level so a click anywhere (dock, stage) dismisses it.
    if (root.context-index >= 0): TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.context-index = -1; }
    }
    if (root.context-index >= 0): Rectangle {
        x: Math.max(4px, Math.min(root.context-x, root.sidebar-w - Style.menu-w - Style.space-xs));
        y: Math.max(4px, Math.min(root.context-y + Style.topbar-h, parent.height - Style.menu-body-y - Style.menu-item-h * 7 - Style.menu-divider-gap - Style.space-tight));
        height: Style.menu-body-y + (root.context-has-lrc ? 7 : 6) * Style.menu-item-h + Style.menu-divider-gap + Style.space-xxs;
        width: Style.menu-w;
        background: Theme.c-bg;
        border-width: Style.stroke;
        border-color: Theme.c-text-hi;
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: Style.menu-header-h;
            Text {
                x: Style.space-sm;
                y: 0px;
                width: parent.width - Style.space-sm * 2;
                height: parent.height;
                vertical-alignment: center;
                text: "  " + root.context-title;
                font-size: Style.font-caption;
                color: Theme.c-text-hi;
                overflow: elide;
            }
            Rectangle {
                y: parent.height - Style.stroke;
                width: parent.width;
                height: Style.stroke;
                background: Theme.c-line;
            }
        }
        Rectangle {
            x: 1px;
            y: Style.menu-body-y;
            width: parent.width - Style.stroke * 2;
            height: (root.context-has-lrc ? 7 : 6) * Style.menu-item-h + Style.menu-divider-gap + Style.space-xxs;
            MenuRow {
                x: 0px;
                y: 0px;
                width: parent.width;
                label: "PLAY";
                clicked => root.play-index(root.context-index);
            }
            MenuRow {
                x: 0px;
                y: Style.menu-item-h * 1;
                width: parent.width;
                label: "PLAY NEXT";
                clicked => root.queue-next(root.context-index);
            }
            MenuRow {
                x: 0px;
                y: Style.menu-item-h * 2;
                width: parent.width;
                label: root.context-has-lrc ? "REPLACE LRC..." : "IMPORT LRC...";
                clicked => root.import-lrc(root.context-index);
            }
            if (root.context-has-lrc): MenuRow {
                x: 0px;
                y: Style.menu-item-h * 3;
                width: parent.width;
                label: "CLEAR LRC";
                clicked => root.clear-lrc(root.context-index);
            }
            MenuRow {
                x: 0px;
                y: (root.context-has-lrc ? 4 : 3) * Style.menu-item-h;
                width: parent.width;
                label: "OPEN LOCATION";
                clicked => root.open-track-location(root.context-index);
            }
            Rectangle {
                y: (root.context-has-lrc ? 5 : 4) * Style.menu-item-h + Style.space-xxs;
                x: Style.space-sm;
                width: parent.width - Style.space-sm * 2;
                height: Style.stroke;
                background: Theme.c-line;
            }
            MenuRow {
                x: 0px;
                y: (root.context-has-lrc ? 5 : 4) * Style.menu-item-h + Style.menu-divider-gap;
                width: parent.width;
                label: "REMOVE FROM LIST";
                clicked => root.remove-track(root.context-index);
            }
            MenuRow {
                x: 0px;
                y: (root.context-has-lrc ? 6 : 5) * Style.menu-item-h + Style.menu-divider-gap;
                width: parent.width;
                label: "DELETE FILE...";
                danger: true;
                clicked => root.delete-track(root.context-index);
            }
        }
    }

    // ============ SYSTEM overlay ============
    // Modal: click anywhere outside the panel closes it.
    if (root.show-settings): TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.toggle-settings(); }
    }
    if (root.show-settings): Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Style.settings-w;
        height: Style.settings-h;
        background: Theme.c-bg;
        border-width: Style.stroke;
        border-color: Theme.c-text-hi;
        // Swallow clicks inside the panel so they do not fall through.
        TouchArea { }
        HorizontalLayout {
            x: Style.panel-inset;
            y: Style.panel-heading-y;
            width: parent.width - Style.panel-inset * 2 - Style.close-w;
            height: Style.control-h;
            spacing: 0px;
            TabBtn {
                width: Style.panel-tab-w;
                label: "[ SYSTEM ]";
                active: root.settings-page == 0;
                clicked => { root.settings-page = 0; }
            }
            TabBtn {
                width: Style.panel-tab-w;
                label: "[ VISUALS ]";
                active: root.settings-page == 1;
                clicked => { root.settings-page = 1; }
            }
            TabBtn {
                width: Style.panel-tab-w;
                label: "[ THEME ]";
                active: root.settings-page == 2;
                clicked => { root.settings-page = 2; }
            }
        }
        CloseX {
            x: parent.width - Style.panel-inset - Style.close-w;
            y: Style.panel-close-y;
            clicked => { root.toggle-settings(); }
        }
        if (root.settings-page == 0): Rectangle {
            x: Style.panel-inset;
            y: Style.panel-body-y;
            width: parent.width - Style.panel-inset * 2;
            height: parent.height - Style.panel-body-y - Style.panel-inset;
            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                text: "SONADIAL PLAYER";
                font-size: Style.font-heading;
                color: Theme.c-text-hi;
            }
            Text {
                x: 0px;
                y: 34px;
                text: "v0.1 / " + root.track-count + " TRACKS / " + root.mode-long;
                font-size: Style.font-caption;
                color: Theme.c-text-dim;
            }
            Text {
                x: 0px;
                y: 58px;
                text: "OUTPUT  " + root.out-label;
                font-size: Style.font-caption;
                color: Theme.c-text;
                overflow: elide;
            }
            Rectangle {
                x: 0px;
                y: 78px;
                width: parent.width;
                height: Style.stroke;
                background: Theme.c-line;
            }
            Text {
                x: 0px;
                y: 84px;
                text: "STATE  " + root.state-path;
                font-size: Style.font-caption;
                color: Theme.c-text;
                overflow: elide;
            }
            Text {
                x: 0px;
                y: 110px;
                text: "SHORTCUTS";
                font-size: Style.font-caption;
                color: Theme.c-text-dim;
            }
            for sc in root.shortcuts: Rectangle {
                x: 0px;
                y: 132px + sc.index * Style.line-h;
                width: parent.width;
                height: Style.line-h;
                Text {
                    // x must be explicit: Slint centres non-layout children
                    // that leave x unset.
                    x: 0px;
                    width: 150px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: sc.keys;
                    font-size: Style.font-caption;
                    color: Theme.c-text-hi;
                }
                Text {
                    x: 150px;
                    width: parent.width - 150px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: sc.desc;
                    font-size: Style.font-caption;
                    color: Theme.c-text;
                    overflow: elide;
                }
            }
            TuiBtn {
                x: 0px;
                y: parent.height - 26px;
                width: 150px;
                label: "[ open data dir ]";
                clicked => root.open-data-dir();
            }
        }
        if (root.settings-page == 1): Rectangle {
            x: Style.panel-inset;
            y: Style.panel-body-y;
            width: parent.width - Style.panel-inset * 2;
            height: parent.height - Style.panel-body-y - Style.panel-inset;
            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                text: "VISUAL EFFECTS";
                font-size: Style.font-heading;
                color: Theme.c-text-hi;
            }
            Text {
                x: 0px;
                y: 38px;
                text: "MODE";
                font-size: Style.font-caption;
                color: Theme.c-text-dim;
            }
            Rectangle {
                x: 0px;
                y: 56px;
                width: (parent.width - Style.space-sm * 2) / 3;
                height: Style.control-h;
                TuiBtn {
                    width: parent.width;
                    label: root.visual-style == 0 ? "[ DEFAULT ON ]" : "[ DEFAULT OFF ]";
                    clicked => root.set-style(0);
                }
            }
            Rectangle {
                x: (parent.width - Style.space-sm * 2) / 3 + 8px;
                y: 56px;
                width: (parent.width - Style.space-sm * 2) / 3;
                height: Style.control-h;
                TuiBtn {
                    width: parent.width;
                    label: root.visual-style == 1 ? "[ DOT MATRIX ON ]" : "[ DOT MATRIX OFF ]";
                    clicked => root.set-style(1);
                }
            }
            Rectangle {
                x: ((parent.width - Style.space-sm * 2) / 3) * 2 + 16px;
                y: 56px;
                width: (parent.width - Style.space-sm * 2) / 3;
                height: Style.control-h;
                // PIANO has no Slint renderer yet; do not offer an active
                // state that just duplicates the previously selected mode.
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "[ PIANO (DEV) ]";
                    font-size: Style.font-caption;
                    color: Theme.c-text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                x: 0px;
                y: 92px;
                text: "LAYERS";
                font-size: Style.font-caption;
                color: Theme.c-text-dim;
            }
            Rectangle {
                x: 0;
                y: 110px;
                width: (parent.width - 8px) / 2;
                height: Style.control-h;
                TuiBtn {
                    width: parent.width;
                    label: root.show-bg-spectrum ? "[ BG SPECTRUM ON ]" : "[ BG SPECTRUM OFF ]";
                    clicked => root.toggle-bg-spectrum();
                }
            }
            Rectangle {
                x: (parent.width - 8px) / 2 + 8px;
                y: 110px;
                width: (parent.width - 8px) / 2;
                height: Style.control-h;
                TuiBtn {
                    width: parent.width;
                    label: root.show-radial ? "[ RADIAL ON ]" : "[ RADIAL OFF ]";
                    clicked => root.toggle-radial();
                }
            }
            Rectangle {
                x: 0;
                y: 136px;
                width: (parent.width - 8px) / 2;
                height: Style.control-h;
                TuiBtn {
                    width: parent.width;
                    label: root.show-core-pulse ? "[ CORE PULSE ON ]" : "[ CORE PULSE OFF ]";
                    clicked => root.toggle-core-pulse();
                }
            }
            Rectangle {
                x: (parent.width - 8px) / 2 + 8px;
                y: 136px;
                width: (parent.width - 8px) / 2;
                height: Style.control-h;
                TuiBtn {
                    width: parent.width;
                    label: root.show-lyrics ? "[ LYRICS ON ]" : "[ LYRICS OFF ]";
                    clicked => root.toggle-lyrics();
                }
            }
            Rectangle {
                x: 0;
                y: 162px;
                width: (parent.width - 8px) / 2;
                height: Style.control-h;
                TuiBtn {
                    width: parent.width;
                    label: root.peak-hold ? "[ PEAK HOLD ON ]" : "[ PEAK HOLD OFF ]";
                    clicked => root.toggle-peak-hold();
                }
            }
            Text {
                x: 0px;
                y: 198px;
                text: "PARAMETERS";
                font-size: Style.font-caption;
                color: Theme.c-text-dim;
            }
            Text {
                x: 0px;
                y: 216px;
                text: "RADIAL SIZE";
                font-size: Style.font-caption;
                color: Theme.c-text-dim;
                height: Style.control-h;
                vertical-alignment: center;
            }
            Rectangle {
                x: 100px;
                y: 216px;
                width: 34px;
                height: Style.control-h;
                TuiBtn {
                    width: parent.width;
                    label: "[-]";
                    clicked => root.adjust-radial-scale(-0.05);
                }
            }
            Text {
                x: 142px;
                y: 216px;
                width: 48px;
                text: Math.round(root.radial-scale * 100.0) + "%";
                font-size: Style.font-caption;
                color: Theme.c-text;
                height: Style.control-h;
                vertical-alignment: center;
            }
            Rectangle {
                x: 198px;
                y: 216px;
                width: 34px;
                height: Style.control-h;
                TuiBtn {
                    width: parent.width;
                    label: "[+]";
                    clicked => root.adjust-radial-scale(0.05);
                }
            }
        }
        if (root.settings-page == 2): Rectangle {
            x: Style.panel-inset;
            y: Style.panel-body-y;
            width: parent.width - Style.panel-inset * 2;
            height: parent.height - Style.panel-body-y - Style.panel-inset;
            clip: true;
            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                text: "THEME";
                font-size: Style.font-heading;
                color: Theme.c-text-hi;
            }
            Text {
                x: 0px;
                y: 34px;
                text: root.theme-current-line;
                font-size: Style.font-caption;
                color: Theme.c-text-dim;
            }
            if (root.theme-auto-status != ""): Text {
                x: 0px;
                y: 52px;
                text: root.theme-auto-status;
                font-size: Style.font-caption;
                color: Theme.c-text-dim;
            }
            Rectangle {
                x: 0;
                y: root.theme-auto-status == "" ? 66px : 76px;
                width: 96px;
                height: Style.theme-group-label-h;
                TuiBtn {
                    width: parent.width;
                    label: "[ RELOAD ]";
                    clicked => root.reload-themes();
                }
            }
            Rectangle {
                x: 104px;
                y: root.theme-auto-status == "" ? 66px : 76px;
                width: 120px;
                height: Style.theme-group-label-h;
                TuiBtn {
                    width: parent.width;
                    label: root.theme-customize-label;
                    clicked => root.customize-theme();
                }
            }
            if (root.theme-load-error != ""): Text {
                x: 0px;
                y: root.theme-auto-status == "" ? 96px : 106px;
                width: parent.width;
                text: root.theme-load-error;
                font-size: Style.font-caption;
                color: Theme.c-danger;
                overflow: elide;
            }
            if (root.theme-warnings != ""): Text {
                x: 0px;
                y: root.theme-auto-status == "" ? 114px : 124px;
                width: parent.width;
                text: root.theme-warnings;
                font-size: Style.font-caption;
                color: Theme.c-danger;
                overflow: elide;
            }
            // AUTO chips and theme groups scroll together in one Flickable;
            // the header above and the FILE footer below stay put.
            Flickable {
                x: 0px;
                y: 140px;
                width: parent.width;
                height: parent.height - 140px - 26px;
                // Explicit content size: the builtin default would derive
                // content-width from the child layout and tie itself in knots.
                content-width: parent.width;
                content-height: root.theme-content-h * 1px;
                VerticalLayout {
                    spacing: Style.theme-gap;
                    Text {
                        height: Style.theme-auto-label-h;
                        text: "AUTO";
                        font-size: Style.font-caption;
                        color: Theme.c-text-dim;
                    }
                    Rectangle {
                        height: Style.chip-h;
                        HorizontalLayout {
                            spacing: Style.theme-gap;
                            for chip in root.auto-chips: ChipBtn {
                                width: (parent.width - Style.theme-gap) / 2;
                                label: chip.name;
                                grad-a: chip.grad-a;
                                grad-b: chip.grad-b;
                                fg: chip.fg;
                                dim: chip.dim;
                                active: chip.active;
                                clicked => root.select-auto-theme(chip.dark);
                            }
                        }
                    }
                    for group in root.theme-groups: Rectangle {
                        height: Style.theme-group-label-h + group.rows * Style.theme-row-step;
                        Text {
                            x: 0px;
                            y: 0px;
                            height: Style.theme-group-label-h;
                            vertical-alignment: center;
                            text: group.label;
                            font-size: Style.font-caption;
                            color: Theme.c-text-dim;
                        }
                        for chip in group.chips: ChipBtn {
                            x: chip.col * ((parent.width - Style.theme-gap * (Style.theme-columns - 1)) / Style.theme-columns + Style.theme-gap);
                            y: Style.theme-group-label-h + chip.row * Style.theme-row-step;
                            width: (parent.width - Style.theme-gap * (Style.theme-columns - 1)) / Style.theme-columns;
                            label: chip.name;
                            grad-a: chip.grad-a;
                            grad-b: chip.grad-b;
                            fg: chip.fg;
                            dim: chip.dim;
                            active: chip.active;
                            clicked => root.select-theme(chip.index);
                        }
                    }
                }
            }
            Text {
                x: 0px;
                y: parent.height - 20px;
                text: "FILE  " + root.theme-file-path;
                font-size: Style.font-caption;
                color: Theme.c-text-dim;
                overflow: elide;
            }
        }
    }

    // ============ EQ overlay ============
    // Modal: click anywhere outside the panel closes it.
    if (root.show-eq): TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.toggle-eq(); }
    }
    if (root.show-eq): Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Style.eq-w;
        height: Style.eq-h;
        background: Theme.c-bg;
        border-width: Style.stroke;
        border-color: Theme.c-text-hi;
        // Swallow clicks inside the panel so they do not fall through.
        TouchArea { }
        Text {
            x: Style.panel-inset;
            y: Style.panel-heading-y;
            text: "GRAPHIC EQUALIZER";
            font-size: Style.font-heading;
            color: Theme.c-text-hi;
        }
        CloseX {
            x: parent.width - Style.panel-inset - Style.close-w;
            y: Style.panel-heading-y;
            clicked => { root.toggle-eq(); }
        }
        Rectangle {
            x: Style.panel-inset;
            y: Style.panel-body-y;
            width: 42px;
            height: Style.control-h;
            TuiBtn {
                width: parent.width;
                label: "[ < ]";
                clicked => root.cycle-eq-preset(-1);
            }
        }
        Text {
            x: 70px;
            y: Style.panel-body-y;
            width: 130px;
            height: Style.control-h;
            vertical-alignment: center;
            text: "PRESET: " + root.eq-preset-name;
            font-size: Style.font-caption;
            color: Theme.c-text-hi;
        }
        Rectangle {
            x: 208px;
            y: Style.panel-body-y;
            width: 42px;
            height: Style.control-h;
            TuiBtn {
                width: parent.width;
                label: "[ > ]";
                clicked => root.cycle-eq-preset(1);
            }
        }
        Rectangle {
            x: 258px;
            y: Style.panel-body-y;
            width: 120px;
            height: Style.control-h;
            TuiBtn {
                width: parent.width;
                label: root.eq-enabled ? "[ ENABLED ON ]" : "[ ENABLED OFF ]";
                clicked => root.toggle-eq-enabled();
            }
        }
        Rectangle {
            x: 386px;
            y: Style.panel-body-y;
            width: 84px;
            height: Style.control-h;
            TuiBtn {
                width: parent.width;
                label: "[ RESET ]";
                clicked => root.reset-eq();
            }
        }
        Rectangle {
            x: Style.panel-inset;
            y: Style.eq-plot-y;
            width: parent.width - Style.panel-inset * 2;
            height: Style.eq-plot-h;
            Rectangle {
                y: (parent.height - Style.eq-band-insets) / 2;
                width: parent.width;
                height: Style.stroke;
                background: Theme.c-line.with-alpha(0.59);
            }
            Rectangle {
                x: Style.space-xs;
                y: Style.eq-band-inset-top;
                width: Style.stroke;
                height: parent.height - Style.eq-band-insets;
                background: Theme.c-line;
            }
            Rectangle {
                x: parent.width - 5px;
                y: Style.eq-band-inset-top;
                width: Style.stroke;
                height: parent.height - Style.eq-band-insets;
                background: Theme.c-line;
            }
            for band[bi] in root.eq-bands: Rectangle {
                x: 4px + bi * ((parent.width - 8px) / 10);
                width: (parent.width - 8px) / 10;
                y: Style.eq-band-inset-top;
                height: parent.height - Style.eq-band-insets;
                property <length> seg-h: (parent.height - Style.eq-band-insets) / 24;
                Text {
                    y: 2px;
                    width: parent.width;
                    text: band.label;
                    font-size: Style.font-caption;
                    color: root.eq-enabled ? Theme.c-text : Theme.c-text-dim;
                    horizontal-alignment: center;
                }
                Text {
                    y: parent.height - 18px;
                    width: parent.width;
                    text: band.freq;
                    font-size: Style.font-caption;
                    color: Theme.c-text-dim;
                    horizontal-alignment: center;
                }
                for seg[si] in 24: Rectangle {
                    property <float> level: si < 12 ? (11.0 - si) : -(si - 11.0);
                    property <bool> lit: band.gain > 0.0 ? band.gain >= self.level - 0.25
                        : (band.gain < 0.0 ? band.gain <= self.level + 0.5 : false);
                    x: (parent.width - parent.width * 0.34) / 2;
                    y: Style.eq-band-inset-top + si * parent.seg-h + 1px;
                    height: parent.seg-h - 2px;
                    width: parent.width * 0.34;
                    background: self.lit ? (si < 12 ? Theme.c-text : Theme.c-text-hi)
                        : Theme.c-line.with-alpha(0.24);
                }
                TouchArea {
                    mouse-cursor: ns-resize;
                    moved => {
                        // Map over the lit segment strip (22 px top inset, 46 px
                        // total insets) so the grabbed band matches the slider.
                        root.set-band(bi, Math.max(-12.0, Math.min(12.0,
                            Math.round((0.5 - (self.mouse-y - Style.eq-band-inset-top) / (self.height - Style.eq-band-insets)) * 48.0) / 2.0)));
                    }
                }
            }
        }
        Text {
            x: Style.panel-inset;
            y: parent.height - 36px;
            text: root.eq-hint;
            font-size: Style.font-caption;
            color: Theme.c-text-dim;
        }
    }

    // ============ BILIBILI overlay ============
    // Modal: click anywhere outside the panel closes it.
    if (root.show-download): TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.open-download(); }
    }
    if (root.show-download): Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Style.download-w;
        height: Style.download-h;
        background: Theme.c-bg;
        border-width: Style.stroke;
        border-color: Theme.c-text-hi;
        // Swallow clicks inside the panel so they do not fall through.
        TouchArea { }
        CloseX {
            x: parent.width - Style.panel-inset - Style.close-w;
            y: Style.panel-heading-y;
            clicked => { root.open-download(); }
        }
        Text {
            x: Style.panel-inset;
            y: 44px;
            text: "Download & Decode";
            font-size: Style.font-heading;
            color: Theme.c-text-hi;
        }
        Rectangle {
            x: Style.panel-inset;
            y: 84px;
            width: parent.width - Style.panel-inset * 2;
            height: 28px;
            background: Theme.c-text-hi.with-alpha(0.92);
            TextInput {
                x: Style.space-sm;
                width: parent.width - Style.space-sm * 2;
                height: parent.height;
                single-line: true;
                font-family: Style.family-pixel;
                font-size: Style.font-pixel-caption;
                color: Theme.c-bg-deep;
                vertical-alignment: center;
                text <=> root.download-url;
                edited => root.set-download-url(root.download-url);
                accepted => root.start-download();
            }
            Text {
                visible: root.download-url == "";
                x: Style.space-sm;
                height: parent.height;
                vertical-alignment: center;
                text: "https://www.bilibili.com/video/BV...";
                font-family: Style.family-pixel;
                font-size: Style.font-pixel-caption;
                color: Theme.c-bg-deep.with-alpha(0.45);
            }
        }
        Text {
            x: Style.panel-inset;
            y: 122px;
            text: "PROXY";
            font-size: Style.font-caption;
            color: Theme.c-text-dim;
        }
        TextInput {
            x: Style.panel-inset;
            y: 136px;
            width: parent.width - (root.env-proxy-visible ? 92px : 40px);
            height: Style.field-h;
            single-line: true;
            font-size: Style.font-caption;
            color: Theme.c-text;
            vertical-alignment: center;
            text <=> root.proxy-text;
            edited => root.set-proxy(root.proxy-text);
        }
        Text {
            visible: root.proxy-text == "";
            x: Style.panel-inset;
            y: 136px;
            height: Style.field-h;
            vertical-alignment: center;
            text: "DIRECT / 127.0.0.1:7890";
            font-size: Style.font-caption;
            color: Theme.c-text-dim.with-alpha(0.55);
        }
        TuiBtn {
            visible: root.env-proxy-visible && root.proxy-text == "";
            x: parent.width - 72px;
            y: 135px;
            width: 52px;
            label: "[ ENV ]";
            clicked => root.use-env-proxy();
        }
        Rectangle {
            x: Style.panel-inset;
            y: 168px;
            width: root.download-running ? 110px : 120px;
            height: Style.control-h;
            TuiBtn {
                width: parent.width;
                label: root.download-running ? "[ CANCEL ]" : "[ DOWNLOAD ]";
                clicked => root.download-running ? root.cancel-download() : root.start-download();
            }
        }
        Rectangle {
            x: 150px;
            y: 168px;
            width: 112px;
            height: Style.control-h;
            TuiBtn {
                width: parent.width;
                label: "[ OPEN DIR ]";
                clicked => root.open-download-dir();
            }
        }
        if (root.download-progress-text != ""): Text {
            x: Style.panel-inset;
            y: 202px;
            text: root.download-progress-text;
            font-size: Style.font-caption;
            color: Theme.c-text-hi;
        }
        if (root.download-status != ""): Text {
            x: Style.panel-inset;
            y: 226px;
            width: parent.width - Style.panel-inset * 2;
            text: root.download-status;
            font-size: Style.font-caption;
            color: Theme.c-text;
            overflow: elide;
        }
        Text {
            x: Style.panel-inset;
            y: parent.height - 58px;
            width: parent.width - Style.panel-inset * 2;
            text: "OUT  " + root.download-out-dir;
            font-size: Style.font-caption;
            color: Theme.c-text-dim;
            overflow: elide;
        }
        Text {
            x: Style.panel-inset;
            y: parent.height - 40px;
            text: "AAC / M4A  |  FFMPEG OPTIONAL";
            font-size: Style.font-caption;
            color: Theme.c-text-dim;
        }
    }

    // ============ delete confirm ============
    if (root.confirm-visible): Rectangle {
        background: Theme.c-bg-deep.with-alpha(0.57);
        // Block the app behind the modal; dismiss with ESC or CANCEL only.
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Style.dialog-w;
            height: Style.dialog-h;
            background: Theme.c-bg;
            border-width: Style.stroke;
            border-color: Theme.c-danger;
            Text {
                x: Style.panel-inset;
                y: Style.space-lg;
                text: "REMOVE TRACK FROM DISK?";
                font-size: Style.font-heading;
                color: Theme.c-text-hi;
            }
            Text {
                x: Style.panel-inset;
                y: 52px;
                width: parent.width - Style.panel-inset * 2;
                text: root.confirm-name;
                font-family: Style.family-pixel;
                font-size: Style.font-pixel-caption;
                color: Theme.c-text-hi;
                overflow: elide;
            }
            Text {
                x: Style.panel-inset;
                y: 74px;
                width: parent.width - Style.panel-inset * 2;
                text: root.confirm-path;
                font-size: Style.font-caption;
                color: Theme.c-text-dim;
                overflow: elide;
            }
            Text {
                x: Style.panel-inset;
                y: 100px;
                text: "THIS CANNOT BE UNDONE.";
                font-size: Style.font-caption;
                color: Theme.c-danger;
            }
            Rectangle {
                x: Style.panel-inset;
                y: parent.height - 40px;
                width: 100px;
                height: Style.control-h;
                TuiBtn {
                    width: parent.width;
                    label: "[ CANCEL ]";
                    clicked => root.cancel-delete();
                }
            }
            Rectangle {
                x: 130px;
                y: parent.height - 40px;
                width: 100px;
                height: Style.control-h;
                TuiBtn {
                    width: parent.width;
                    label: "[ DELETE ]";
                    clicked => root.confirm-delete();
                }
            }
        }
    }

    // ============ error toast ============
    if (root.error-visible): Rectangle {
        x: parent.width - self.width - 20px;
        y: parent.height - Style.dock-h - Style.space-2xl - self.height;
        width: Style.toast-w;
        height: Style.toast-h;
        background: Theme.c-bg;
        border-width: Style.stroke;
        border-color: Theme.c-text-hi;
        TouchArea { }
        Text {
            x: Style.space-md;
            y: Style.space-sm;
            text: "ERROR";
            font-size: Style.font-caption;
            color: Theme.c-danger;
        }
        CloseX {
            x: parent.width - 46px;
            y: Style.space-xs;
            clicked => root.clear-error();
        }
        Text {
            x: Style.space-md;
            y: 30px;
            width: parent.width - Style.space-md * 2;
            text: root.error-text;
            font-size: Style.font-caption;
            color: Theme.c-text-hi;
            overflow: elide;
        }
    }
}
